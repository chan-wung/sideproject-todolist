              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
              />
              <path
                d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
              />
            </svg>
          </button>
          <button
            aria-label="삭제"
            class="todo-item__btn todo-item__btn--delete"
            type="button"
          >
            <svg
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <polyline
                points="3 6 5 6 21 6"
              />
              <path
                d="M19 6l-1 14H6L5 6"
              />
              <path
                d="M10 11v6M14 11v6"
              />
              <path
                d="M9 6V4h6v2"
              />
            </svg>
          </button>
          <div
            class="todo-item__more"
          >
            <button
              aria-expanded="false"
              aria-haspopup="true"
              aria-label="더보기"
              class="todo-item__btn todo-item__btn--more"
              type="button"
            >
              <svg
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <circle
                  cx="12"
                  cy="5"
                  r="1.8"
                />
                <circle
                  cx="12"
                  cy="12"
                  r="1.8"
                />
                <circle
                  cx="12"
                  cy="19"
                  r="1.8"
                />
              </svg>
            </button>
          </div>
        </div>
      </div>
      <div
        class="todo-item__meta"
      >
        <span
          class="todo-item__badge todo-item__badge--medium"
        >
          보통
        </span>
        <span
          class="todo-item__category"
        >
          업무
        </span>
        <button
          aria-label="메모 연결"
          class="todo-item__memo-link todo-item__memo-link--empty"
          type="button"
        >
          📎 메모 연결
        </button>
      </div>
      <div
        class="todo-item__dates"
      >
        <span
          class="todo-item__dates-text"
        >
          등록일: 
          2026.07.01
        </span>
        <span
          aria-hidden="true"
          class="todo-item__dates-sep"
        >
          /
        </span>
        <span
          class="todo-item__dates-text"
        >
          마감일: 
          2099.01.01
        </span>
      </div>
      <div
        class="todo-item__subtasks"
        id="todo-subtasks-t1"
      />
      <div
        class="todo-item__sub-add"
      >
        <input
          class="todo-item__sub-add-field"
          placeholder="하위 항목 추가"
          type="text"
          value=""
        />
        <button
          aria-label="하위 항목 추가"
          class="todo-item__sub-add-btn"
          type="button"
        >
          <span
            class="screen-out"
          >
            추가
          </span>
        </button>
      </div>
    </div>
  </div>
</div>
`;

